/*
 * RFT: Wio BG770A application overlay.
 *
 * - Disable Zephyr modem subsystem binding on uart1; we drive AT directly
 *   from src/connection/modem.c. Keeps uart1 itself enabled with HW flow
 *   control to BG770A-GL.
 * - Enable timer1 for the periodic ESB sync (esb.c).
 * - LED is via the board's `led0` GPIO alias; no PWM color LED on this
 *   board, so we only define `led-gpios` mirror for the led module's
 *   `zephyr,user` lookup path.
 */

&modem {
	status = "disabled";
};

&timer1 {
	status = "okay";
};

/ {
	zephyr,user {
		led-gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>;

		/* RFT modem control lines, originally exposed by the disabled
		 * `&modem` node above. We drive AT directly so they live on
		 * zephyr,user instead of a Zephyr-modem-driver binding. */
		modem-power-gpios = <&gpio1 1 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>;
		modem-reset-gpios = <&gpio1 15 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>;
	};
};

&cryptocell {
	status = "disabled";
};

&nfct {
	status = "disabled";
};
